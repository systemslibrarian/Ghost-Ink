version: "1.0.0"
url: "https://systemslibrarian.github.io/Ghost-Ink/"
repository-code: "https://github.com/systemslibrarian/Ghost-Ink"
license: MIT
keywords:
  - security education
  - steganography
  - Unicode
  - hidden content
  - digital forensics
  - detection boundaries
